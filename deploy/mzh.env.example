# /opt/mizhenhe/mzh.env —— 由 install.sh 首次安装时自动生成，chmod 600
# 这三个密钥与客户端验签/后台写操作直接相关，改动后需 systemctl restart mizhenhe
SWITCH_SECRET=REPLACE_WITH_RANDOM_HEX
ADMIN_TOKEN=REPLACE_WITH_RANDOM_HEX
BAIDU_API_SECRET=REPLACE_WITH_RANDOM_HEX

# 挂在 https://app.kqi.ink/mzh 子路径下
PUBLIC_PREFIX=/mzh
# 公网模式：/admin/state 不再下发写操作令牌
MZH_PUBLIC=1
