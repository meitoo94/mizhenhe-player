// Release / 上架包：后端已部署到用户自有域名 https://app.kqi.ink/mzh
// 复用该域名现有 HTTPS 证书，不需要新子域、不需要新备案。
// App Store 审核态不允许明文 HTTP（Info.plist 里已去掉 ATS 例外）。
MZH_TEAM_ID = 25F879952L
MZH_BUNDLE_ID = com.mizhenhe.player
MZH_VERSION = 1.0
MZH_BUILD_NUMBER = 2

// xcconfig 里 "//" 会被当注释，URL 用 /$()/ 还原双斜杠。
CONFIG_BASE_URL = https:/$()/app.kqi.ink/mzh

CODE_SIGN_STYLE = Automatic
