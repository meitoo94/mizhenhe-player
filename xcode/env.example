# 复制成变量填进 shell，或写进 ~/.zshrc（不要提交到仓库）
# App Store Connect > 用户和访问 > 集成 > 密钥，创建 Admin/App Manager 权限的密钥
export ASC_KEY_ID="XXXXXXXXXX"
export ASC_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# .p8 文件放到: ~/.appstoreconnect/private_keys/AuthKey_${ASC_KEY_ID}.p8
# Team ID 在 developer.apple.com > Account > Membership 里看，填进两个 xcconfig
export MZH_TEAM_ID="XXXXXXXXXX"
